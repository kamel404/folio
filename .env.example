# Copy to .env.local and fill in. .env.local is git-ignored — never commit real keys.

# ── Supabase (Project Settings → API) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "anon" key (or the newer "publishable" key). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key (or the newer "secret" key). SERVER ONLY — bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ───────────────────────────────────────────────────────
# Origin used in email links (confirm / reset password)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Root domain for tenant subdomains. Local: lina.localhost:3000 works in browsers.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ── AI (Google AI Studio → API keys). SERVER ONLY ──────────────
GEMINI_API_KEY=
# Optional overrides (defaults: gemini-3.5-flash, falling back to gemini-3.5-flash-lite when busy)
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=

# ── Payments: Lemon Squeezy. SERVER ONLY ───────────────────────
# Use test-mode values locally (toggle "Test mode" in the Lemon Squeezy dashboard).
# Until all of these are set, the plan buttons show "Checkout opens shortly".
# Settings → API → new key
LEMON_SQUEEZY_API_KEY=
# Settings → Stores → the number in the store's URL / ID column
LEMON_SQUEEZY_STORE_ID=
# Settings → Webhooks → the signing secret you typed when creating the webhook
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Products → each product → variant ID (prices must match src/lib/payments/plans.ts)
LEMON_SQUEEZY_VARIANT_STARTER_MONTHLY=
LEMON_SQUEEZY_VARIANT_STARTER_ANNUAL=
LEMON_SQUEEZY_VARIANT_PRO_MONTHLY=
LEMON_SQUEEZY_VARIANT_PRO_ANNUAL=
